# Dhan credentials: set these only in Render Environment, never in source code
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Optional manual token fallback; prefer TOTP auto-generation
DHAN_ACCESS_TOKEN=

PORT=10000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*
CLIENT_API_KEY=

AUTO_SUBSCRIBE_INDICES=true
ENABLE_LIVE_FEED=true
ENABLE_20_DEPTH=true
MAX_CLIENTS=20
MAX_SUBSCRIPTIONS=5000
MAX_TICKS_PER_INSTRUMENT=3000
MAX_CANDLES_PER_INSTRUMENT=2000
TICK_BUFFER_SIZE=10000
TICK_STALE_MS=15000
STALE_AFTER_MS=5000
LIVE_HISTORY_REFRESH_MS=10000
CANDLE_TIMEFRAME_MS=60000
OPTION_CHAIN_REFRESH_MS=3200
DEPTH_MAX_INSTRUMENTS=50

NIFTY_SECURITY_ID=13
BANKNIFTY_SECURITY_ID=25
FINNIFTY_SECURITY_ID=27
MIDCPNIFTY_SECURITY_ID=442
SENSEX_SECURITY_ID=51
NIFTY_SEGMENT=IDX_I
BANKNIFTY_SEGMENT=IDX_I
FINNIFTY_SEGMENT=IDX_I
MIDCPNIFTY_SEGMENT=IDX_I
SENSEX_SEGMENT=IDX_I

# Generate once; same pair is used by all your PWA versions.
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
